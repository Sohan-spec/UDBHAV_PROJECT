# =============================================================================
# UDBHAV  Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in all values before starting the server.
# The server will REFUSE TO START if SECRET_KEY or ADMIN_SECURITY_PIN is missing.
# =============================================================================

# ── Django Secret Key (MANDATORY) ─────────────────────────────────────────────
# Generate a new key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# NEVER use a hardcoded or version-controlled value.
SECRET_KEY=your-secure-random-secret-key-here

# ── Debug Mode ────────────────────────────────────────────────────────────────
# NEVER set to True on a production server.
DEBUG=False

# ── Allowed Hosts ─────────────────────────────────────────────────────────────
# Comma-separated list of hosts/domains allowed to serve this application.
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Admin Operations Security PIN (MANDATORY) ─────────────────────────────────
# Required to authorize admin product-creation API calls (X-Admin-Pin header).
# Use a strong, unique value  minimum 8 digits/characters recommended.
# Default is intentionally blank: the server rejects admin actions if this is empty.
ADMIN_SECURITY_PIN=your-strong-admin-pin-here
